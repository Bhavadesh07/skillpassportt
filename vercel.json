{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "frontend",
  "functions": {
    "api/index.js": {
      "includeFiles": "node_modules/pdfjs-dist/legacy/build/**"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.js" },
    { "source": "/static/(.*)", "destination": "/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
